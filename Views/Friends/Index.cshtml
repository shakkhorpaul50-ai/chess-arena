@model FriendsViewModel
@{
    ViewData["Title"] = "Friends";
}

<div class="max-w-4xl mx-auto px-4 py-10">
    <h1 class="text-3xl font-bold text-white mb-8">Friends</h1>

    <div class="mb-8">
        <form asp-controller="Friends" asp-action="Add" method="post" class="flex gap-2" novalidate>
            @Html.AntiForgeryToken()
            <input name="emailOrName" class="flex-1 px-4 py-3 rounded-xl bg-slate-800 border border-slate-700 focus:border-emerald-500 focus:outline-none text-slate-100" placeholder="Add a friend by email or display name" />
            <button type="submit" class="px-5 py-3 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-semibold transition">Add</button>
        </form>
        <div asp-validation-summary="All" class="text-sm text-red-400 mt-3"></div>
    </div>

    @if (Model.IncomingRequests.Count > 0)
    {
        <section class="mb-8">
            <h2 class="text-sm font-semibold text-slate-400 uppercase tracking-wider mb-3">Incoming requests</h2>
            <div class="space-y-2">
                @foreach (var f in Model.IncomingRequests)
                {
                    <div class="flex items-center justify-between px-4 py-3 rounded-xl bg-amber-950/40 border border-amber-500/30">
                        <p class="font-medium text-sm text-slate-100">@f.Requester?.DisplayName</p>
                        <div class="flex gap-2">
                            <form asp-controller="Friends" asp-action="Accept" asp-route-id="@f.Id" method="post">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="px-3 py-1.5 rounded-lg bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-semibold text-xs transition">Accept</button>
                            </form>
                            <form asp-controller="Friends" asp-action="Decline" asp-route-id="@f.Id" method="post">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="px-3 py-1.5 rounded-lg border border-slate-600 hover:border-red-500 hover:text-red-400 text-xs transition">Decline</button>
                            </form>
                        </div>
                    </div>
                }
            </div>
        </section>
    }

    @if (Model.OutgoingRequests.Count > 0)
    {
        <section class="mb-8">
            <h2 class="text-sm font-semibold text-slate-400 uppercase tracking-wider mb-3">Sent requests</h2>
            <div class="space-y-2">
                @foreach (var f in Model.OutgoingRequests)
                {
                    <div class="flex items-center justify-between px-4 py-3 rounded-xl bg-slate-800/60 border border-slate-800">
                        <p class="font-medium text-sm text-slate-100">@f.Addressee?.DisplayName</p>
                        <form asp-controller="Friends" asp-action="Remove" asp-route-id="@f.AddresseeId" method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="px-3 py-1.5 rounded-lg border border-slate-600 hover:border-red-500 hover:text-red-400 text-xs transition">Cancel</button>
                        </form>
                    </div>
                }
            </div>
        </section>
    }

    <section>
        <h2 class="text-sm font-semibold text-slate-400 uppercase tracking-wider mb-3">Your friends</h2>
        @if (Model.Friends.Count == 0)
        {
            <p class="text-sm text-slate-500 py-6 text-center bg-slate-900/40 border border-slate-800 rounded-2xl">No friends yet. Add someone above.</p>
        }
        else
        {
            <div class="grid gap-3 sm:grid-cols-2">
                @foreach (var (friend, wins) in Model.Friends)
                {
                    <div class="flex items-center justify-between px-4 py-3 rounded-xl bg-slate-900/60 border border-slate-800">
                        <div>
                            <p class="font-medium text-sm text-slate-100">@friend.DisplayName</p>
                            <p class="text-xs text-slate-500">rating @friend.Rating &middot; @(friend.IsBot ? "bot" : "human")</p>
                        </div>
                        <form asp-controller="Friends" asp-action="Remove" asp-route-id="@friend.Id" method="post" onsubmit="return confirm('Remove this friend?')">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="text-xs px-3 py-1.5 rounded-lg border border-slate-700 hover:border-red-500 hover:text-red-400 transition">Remove</button>
                        </form>
                    </div>
                }
            </div>
        }
    </section>
</div>