@model List<TournamentListItem>
@{
    ViewData["Title"] = "Tournaments";
}

<div class="max-w-4xl mx-auto px-4 py-10">
    <div class="flex items-center justify-between mb-8">
        <div>
            <h1 class="text-3xl font-bold text-white">Tournaments</h1>
            <p class="text-slate-400 mt-1">Swiss-system events. Join during registration and play your matches whenever you're ready.</p>
        </div>
        @if (User.IsInRole("Admin"))
        {
            <a asp-controller="Admin" asp-action="Index" class="px-4 py-2.5 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-semibold text-sm transition whitespace-nowrap">
                Manage tournaments
            </a>
        }
    </div>

    @if (Model.Count == 0)
    {
        <div class="bg-slate-900/60 border border-slate-800 rounded-2xl p-12 text-center">
            <p class="text-slate-400">No tournaments yet.</p>
            @if (User.IsInRole("Admin"))
            {
                <p class="text-sm text-slate-500 mt-2">Create the first one from the admin panel.</p>
            }
        </div>
    }
    else
    {
        <div class="space-y-3">
            @foreach (var item in Model)
            {
                var t = item.Tournament;
                <a asp-controller="Tournament" asp-action="Detail" asp-route-id="@t.Id"
                   class="flex flex-wrap items-center justify-between gap-4 px-5 py-4 rounded-2xl bg-slate-900/60 border border-slate-800 hover:border-emerald-500/50 transition">
                    <div>
                        <p class="font-semibold text-slate-100">@t.Name</p>
                        <p class="text-xs text-slate-500 mt-1">
                            @item.PlayerCount/@t.PlayerLimit players &middot; @t.TotalRounds rounds &middot; @t.TimeControlLabel &middot; created @t.CreatedUtc.ToLocalTime().ToString("MMM d, yyyy")
                        </p>
                    </div>
                    <div class="flex items-center gap-3">
                        <span class="text-xs px-2.5 py-1 rounded-md @(t.Status switch {
                                TournamentStatus.Registration => "bg-amber-500/15 text-amber-400",
                                TournamentStatus.Running => "bg-emerald-500/15 text-emerald-400",
                                _ => "bg-slate-700/50 text-slate-400" })">
                            @t.Status
                        </span>
                        @if (t.Status == TournamentStatus.Running)
                        {
                            <span class="text-xs text-slate-400">Round @t.CurrentRound of @t.TotalRounds</span>
                        }
                    </div>
                </a>
            }
        </div>
    }
</div>
