@model TournamentDetailViewModel
@{
    ViewData["Title"] = Model.Tournament.Name;
    var t = Model.Tournament;
}

<div class="max-w-6xl mx-auto px-4 py-10">
    <div class="flex flex-wrap items-start justify-between gap-4 mb-8">
        <div>
            <h1 class="text-3xl font-bold text-white">@t.Name</h1>
            <p class="text-slate-400 mt-1">
                @t.Players.Count/@t.PlayerLimit players &middot; @t.TotalRounds rounds &middot; @t.TimeControlLabel &middot;
                <span class="@(t.Status == TournamentStatus.Running ? "text-emerald-400" : t.Status == TournamentStatus.Registration ? "text-amber-400" : "text-slate-400")">@t.Status</span>
                @if (t.Status == TournamentStatus.Running)
                {
                    <text>&middot; Round @t.CurrentRound of @t.TotalRounds</text>
                }
            </p>
        </div>
        <div class="flex gap-3">
            @if (Model.CanJoin)
            {
                <form asp-controller="Tournament" asp-action="Join" asp-route-id="@t.Id" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="px-5 py-2.5 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-semibold text-sm transition">Join tournament</button>
                </form>
            }
            @if (Model.IsRegistered && t.Status == TournamentStatus.Registration)
            {
                <form asp-controller="Tournament" asp-action="Leave" asp-route-id="@t.Id" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="px-5 py-2.5 rounded-xl border border-slate-600 hover:border-red-500 hover:text-red-400 text-sm transition">Leave</button>
                </form>
            }
        </div>
    </div>

    @if (TempData["Error"] is not null)
    {
        <div class="mb-6 px-4 py-3 rounded-xl bg-red-950/60 border border-red-500/40 text-sm text-red-300">@TempData["Error"]</div>
    }

    <div id="tournament-board" data-tournament-id="@t.Id">
        <partial name="_TournamentBoard" model="Model" />
    </div>
</div>

@section Scripts {
    <script src="~/js/tournament.js" asp-append-version="true"></script>
}