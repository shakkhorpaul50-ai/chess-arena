@model RegisterViewModel
@{
    ViewData["Title"] = "Register";
}

<div class="max-w-md mx-auto px-4 py-16">
    <div class="bg-slate-900/60 border border-slate-800 rounded-2xl p-8">
        <h1 class="text-2xl font-bold text-white mb-1">Create your account</h1>
        <p class="text-sm text-slate-400 mb-6">Join the arena and start playing in seconds.</p>

        <form asp-controller="Account" asp-action="Register" method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="text-sm text-red-400 mb-4"></div>

            <div class="mb-4">
                <label asp-for="DisplayName" class="block text-sm font-medium text-slate-300 mb-1.5">Display name</label>
                <input asp-for="DisplayName" autocomplete="nickname" class="w-full px-3.5 py-2.5 rounded-lg bg-slate-800 border border-slate-700 focus:border-emerald-500 focus:outline-none text-slate-100" placeholder="Your chess name" />
                <span asp-validation-for="DisplayName" class="text-xs text-red-400"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Email" class="block text-sm font-medium text-slate-300 mb-1.5">Email</label>
                <input asp-for="Email" autocomplete="email" class="w-full px-3.5 py-2.5 rounded-lg bg-slate-800 border border-slate-700 focus:border-emerald-500 focus:outline-none text-slate-100" placeholder="you@example.com" />
                <span asp-validation-for="Email" class="text-xs text-red-400"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Password" class="block text-sm font-medium text-slate-300 mb-1.5">Password</label>
                <input asp-for="Password" autocomplete="new-password" class="w-full px-3.5 py-2.5 rounded-lg bg-slate-800 border border-slate-700 focus:border-emerald-500 focus:outline-none text-slate-100" placeholder="At least 8 characters" />
                <span asp-validation-for="Password" class="text-xs text-red-400"></span>
            </div>

            <div class="mb-6">
                <label asp-for="ConfirmPassword" class="block text-sm font-medium text-slate-300 mb-1.5">Confirm password</label>
                <input asp-for="ConfirmPassword" autocomplete="new-password" class="w-full px-3.5 py-2.5 rounded-lg bg-slate-800 border border-slate-700 focus:border-emerald-500 focus:outline-none text-slate-100" />
                <span asp-validation-for="ConfirmPassword" class="text-xs text-red-400"></span>
            </div>

            <button type="submit" class="w-full py-3 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-semibold transition">Create account</button>
        </form>

        <p class="text-sm text-slate-400 mt-6 text-center">
            Already have an account?
            <a asp-controller="Account" asp-action="Login" class="text-emerald-400 hover:text-emerald-300">Sign in</a>
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}