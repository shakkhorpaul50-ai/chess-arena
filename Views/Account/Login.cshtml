@model LoginViewModel
@{
    ViewData["Title"] = "Sign in";
}

<div class="max-w-md mx-auto px-4 py-16">
    <div class="bg-slate-900/60 border border-slate-800 rounded-2xl p-8">
        <h1 class="text-2xl font-bold text-white mb-1">Welcome back</h1>
        <p class="text-sm text-slate-400 mb-6">Sign in to play, challenge friends and watch matches.</p>

        <form asp-controller="Account" asp-action="Login" method="post" novalidate>
            <input type="hidden" asp-for="ReturnUrl" />
            <div asp-validation-summary="ModelOnly" class="text-sm text-red-400 mb-4"></div>

            <div class="mb-4">
                <label asp-for="Email" class="block text-sm font-medium text-slate-300 mb-1.5">Email</label>
                <input asp-for="Email" autocomplete="email" class="w-full px-3.5 py-2.5 rounded-lg bg-slate-800 border border-slate-700 focus:border-emerald-500 focus:outline-none text-slate-100" />
                <span asp-validation-for="Email" class="text-xs text-red-400"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Password" class="block text-sm font-medium text-slate-300 mb-1.5">Password</label>
                <input asp-for="Password" autocomplete="current-password" class="w-full px-3.5 py-2.5 rounded-lg bg-slate-800 border border-slate-700 focus:border-emerald-500 focus:outline-none text-slate-100" />
                <span asp-validation-for="Password" class="text-xs text-red-400"></span>
            </div>

            <label class="flex items-center gap-2 text-sm text-slate-400 mb-6">
                <input asp-for="RememberMe" class="accent-emerald-500" />
                Keep me signed in
            </label>

            <button type="submit" class="w-full py-3 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-semibold transition">Sign in</button>
        </form>

        <p class="text-sm text-slate-400 mt-6 text-center">
            New here?
            <a asp-controller="Account" asp-action="Register" class="text-emerald-400 hover:text-emerald-300">Create an account</a>
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}