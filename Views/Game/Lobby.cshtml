@model LobbyViewModel
@{
    ViewData["Title"] = "Play Online";
}

<div class="max-w-7xl mx-auto px-4 py-10">
    <h1 class="text-3xl font-bold text-white mb-1">Play online</h1>
    <p class="text-slate-400 mb-8">Challenge anyone who is online. Choose a time control, then click a player.</p>

    <div class="grid gap-8 lg:grid-cols-3">

        <section class="lg:col-span-2 bg-slate-900/60 border border-slate-800 rounded-2xl p-6">
            <div class="flex items-center justify-between mb-4">
                <h2 class="text-lg font-semibold text-white">Players online</h2>
                <span id="online-count" class="text-xs px-2 py-1 rounded-md bg-emerald-500/15 text-emerald-400">connecting...</span>
            </div>

            <div class="mb-6">
                <label class="block text-sm font-medium text-slate-300 mb-2">Time control</label>
                <select id="time-control-select" class="w-full sm:w-64 px-3.5 py-2.5 rounded-lg bg-slate-800 border border-slate-700 focus:border-emerald-500 focus:outline-none text-slate-100">
                    @foreach (var tc in Model.TimeControls)
                    {
                        <option value="@($"{tc.BaseMinutes},{tc.IncrementSeconds}")">@tc.Label</option>
                    }
                </select>
            </div>

            <div id="online-players" class="space-y-2">
                <p class="text-sm text-slate-500 py-4 text-center">Connecting to the arena...</p>
            </div>

            <div id="challenge-banner" class="hidden mt-6 p-4 rounded-xl bg-sky-950/70 border border-sky-500/40">
                <div id="challenge-banner-body" class="flex flex-wrap items-center justify-between gap-3"></div>
            </div>
        </section>

        <section class="bg-slate-900/60 border border-slate-800 rounded-2xl p-6">
            <h2 class="text-lg font-semibold text-white mb-4">Live games</h2>
            <div id="lobby-games" class="space-y-2">
                <p class="text-sm text-slate-500 py-4 text-center">No games yet.</p>
            </div>
        </section>
    </div>
</div>

@section Scripts {
    <script>window.__CURRENT_USER_ID__ = '@Model.CurrentUserId';</script>
    <script src="~/js/lobby.js" asp-append-version="true"></script>
}
