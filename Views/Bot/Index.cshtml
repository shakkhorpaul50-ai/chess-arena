@{
    ViewData["Title"] = "Play vs Bot";
}

<div class="max-w-lg mx-auto px-4 py-16">
    <div class="bg-slate-900/60 border border-slate-800 rounded-2xl p-8">
        <h1 class="text-2xl font-bold text-white mb-1">Play vs ChessBot</h1>
        <p class="text-sm text-slate-400 mb-6">Powered by Stockfish. Choose your difficulty and time control.</p>

        <form asp-controller="Bot" asp-action="Start" method="post" novalidate>
            @Html.AntiForgeryToken()

            <div class="mb-6">
                <label class="block text-sm font-medium text-slate-300 mb-2">Difficulty</label>
                <div class="grid grid-cols-3 gap-2">
                    <label class="cursor-pointer">
                        <input type="radio" name="difficulty" value="easy" class="peer sr-only" checked />
                        <span class="block text-center px-3 py-2.5 rounded-xl border border-slate-700 bg-slate-800 text-slate-100 text-sm font-medium transition peer-checked:border-emerald-500 peer-checked:bg-emerald-500/15 peer-checked:text-emerald-300 hover:border-slate-500">
                            Easy
                            <span class="block text-xs text-slate-500 mt-0.5">Casual</span>
                        </span>
                    </label>
                    <label class="cursor-pointer">
                        <input type="radio" name="difficulty" value="medium" class="peer sr-only" />
                        <span class="block text-center px-3 py-2.5 rounded-xl border border-slate-700 bg-slate-800 text-slate-100 text-sm font-medium transition peer-checked:border-emerald-500 peer-checked:bg-emerald-500/15 peer-checked:text-emerald-300 hover:border-slate-500">
                            Medium
                            <span class="block text-xs text-slate-500 mt-0.5">Challenging</span>
                        </span>
                    </label>
                    <label class="cursor-pointer">
                        <input type="radio" name="difficulty" value="hard" class="peer sr-only" />
                        <span class="block text-center px-3 py-2.5 rounded-xl border border-slate-700 bg-slate-800 text-slate-100 text-sm font-medium transition peer-checked:border-emerald-500 peer-checked:bg-emerald-500/15 peer-checked:text-emerald-300 hover:border-slate-500">
                            Hard
                            <span class="block text-xs text-slate-500 mt-0.5">Brutal</span>
                        </span>
                    </label>
                </div>
            </div>

            <div class="grid grid-cols-2 gap-4 mb-8">
                <div>
                    <label for="baseMinutes" class="block text-sm font-medium text-slate-300 mb-1.5">Minutes</label>
                    <select id="baseMinutes" name="baseMinutes" class="w-full px-3.5 py-2.5 rounded-lg bg-slate-800 border border-slate-700 focus:border-emerald-500 focus:outline-none text-slate-100">
                        <option>1</option><option>3</option><option selected>5</option>
                        <option>10</option><option>15</option><option>30</option>
                    </select>
                </div>
                <div>
                    <label for="incrementSeconds" class="block text-sm font-medium text-slate-300 mb-1.5">Increment (s)</label>
                    <select id="incrementSeconds" name="incrementSeconds" class="w-full px-3.5 py-2.5 rounded-lg bg-slate-800 border border-slate-700 focus:border-emerald-500 focus:outline-none text-slate-100">
                        <option selected>0</option><option>2</option><option>5</option><option>10</option>
                    </select>
                </div>
            </div>

            <button type="submit" class="w-full py-3 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-semibold transition">
                Start game vs bot
            </button>
        </form>
    </div>
</div>
